# Public site URL (used for sitemap, canonical and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.zainandco.pk

# REQUIRED IN PRODUCTION: every submitted lead is POSTed here as JSON
# (Google Apps Script, Zapier, Make, n8n, CRM...). On serverless hosts such as Vercel the local
# .data/leads.jsonl fallback cannot persist, so without this leads would be lost.
LEAD_WEBHOOK_URL=

# Optional: live Google rating + latest reviews in the Reviews section (Places API (New)).
# Without these the section shows site.google.rating / count from src/data/site.ts.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Optional: link for the "Google Rating" badge (your Google Business review page)
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=

# Optional: address or "lat,lng" used by the map embed and the Get Directions button
NEXT_PUBLIC_MAPS_QUERY=Plot 18-C, Commercial Broadway, DHA Phase 5, Lahore, Pakistan

# Optional analytics. Nothing is loaded (and no cookie banner is shown) unless at least one is set.
# Scripts only load after the visitor accepts the cookie banner.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
